# ==========================================
# AI Trust & Security Auditor - Env Template
# ==========================================

# Configurações do Backend (FastAPI)
HOST=0.0.0.0
PORT=8000

# Conexão com Banco de Dados (Exemplo)
DATABASE_URL=sqlite:///./auditor.db

# Chaves de API e Segredos (NÃO COLOQUE CHAVES REAIS AQUI)
# Substitua as chaves abaixo no seu arquivo .env local
LLM_API_KEY=sk-sua_chave_de_api_aqui
JWT_SECRET_KEY=sua_chave_secreta_jwt_aqui

# Configurações do Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000